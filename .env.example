# Genesis Node API - Environment Variables Example
#
# This file documents all environment variables used by the genesis-node-api application.
# Copy this file to .env.local (or .env for production) and fill in your values.

# SERVER CONFIGURATION
# Port on which the Express server listens. Defaults to 6970 if not specified.
# Type: number
# Required: No
PORT=6970

# DATABASE CONFIGURATION
# Path to the JSON database file. Defaults to ./db.json in the project root.
# Type: string (file path)
# Required: No
DB_PATH=./db.json

# SOLANA NETWORK CONFIGURATION
# The Solana network to connect to: mainnet, devnet, testnet, or localhost
# Type: string
# Required: No (defaults to devnet)
# Valid values: mainnet, devnet, testnet, localhost
SOLANA_NETWORK=devnet

# Solana RPC URL for connecting to the blockchain. If not specified, defaults are used based on SOLANA_NETWORK.
# Type: string (URL)
# Required: No
# Defaults: mainnet -> https://api.mainnet-beta.solana.com, devnet -> https://api.devnet.solana.com, etc.
SOLANA_RPC_URL=https://api.devnet.solana.com

# FLUX TOKEN CONFIGURATION
# The Solana mint address for the FLUX token
# Type: string (Solana public key)
# Required: No (defaults to the known devnet FLUX mint address)
FLUX_MINT_ADDRESS=4CkR2jysfcsk3Mdn86KuuUkRSBBPwtN1fPaaffawLax9

# Number of decimal places for FLUX token amounts (typically 9 for SPL tokens)
# Type: number
# Required: No (defaults to 9)
FLUX_DECIMALS=9

# MARKETPLACE WALLET CONFIGURATION
# Treasury wallet address for receiving protocol fees from transactions
# Type: string (Solana public key)
# Required: No (defaults to a known address)
TREASURY_WALLET=5JfVfdEAAuwop51RLx6rUbooiEd1vTSxyw2DhkjPbA8G

# PAYMENT CONFIGURATION
# Stripe secret API key for payment processing
# Type: string (Stripe secret key, starts with sk_)
# Required: Yes (if using Stripe payment functionality)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# USER HOME DIRECTORY
# Home directory path used for locating Solana keypairs. Usually set by the system.
# Type: string (file path)
# Required: No (defaults to system HOME environment variable)
HOME=/Users/username

# NOTES
# - Keypairs are loaded from: $HOME/openclaw-craig/.openclaw/solana/{agentName}.json
# - The protocol charges a 5% fee on all marketplace transactions
# - Ensure STRIPE_SECRET_KEY is kept secret and never committed to version control
